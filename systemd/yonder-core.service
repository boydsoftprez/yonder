[Unit]
Description=Yonder core configuration service
Documentation=https://github.com/boydsoftprez/yonder
After=local-fs.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
# /usr/local/bin/yonder-node, not /usr/bin/node: a unit's ExecStart is an
# absolute path that systemd resolves against nothing, and the offline install
# route puts its bundled runtime at /opt/yonder/node/bin/node and on PATH for
# the installer's own run only. Naming the distro path was therefore
# `Unable to locate executable '/usr/bin/node'`, status=203/EXEC, for ever
# under Restart=always. The installer's link_node points this fixed path at
# whichever node it resolved — bundled or packaged — so both routes look the
# same from here. See installer/lib/common.sh.
ExecStart=/usr/local/bin/yonder-node /opt/yonder/packages/yonder-core/dist/daemon/server.js
Restart=always
RestartSec=2
# No User=. This daemon drives NetworkManager and stays root.
#
# Group=, though, is what makes the socket reachable. systemd sets the
# process's primary group from this, so /run/yonder is created root:yonder
# 0750 and the socket the daemon binds inside it inherits that group; the
# chmod to 0660 in src/daemon/server.ts then makes it group-writable, and a
# console running as the unprivileged yonder user can open it. Nothing chowns
# from code: the unit is the one place this is expressed (K-01, R-SEC-04).
#
# The account must exist before this unit is started, or systemd fails it at
# step USER with status=217 on every start — which for this daemon is a board
# with no access point and no console. installer/roles/10-base.sh creates it
# and assert_unit_accounts checks it before anything is enabled.
Group=yonder
RuntimeDirectory=yonder
RuntimeDirectoryMode=0750
StateDirectory=yonder
StateDirectoryMode=0750
ProtectSystem=strict
# /etc/NetworkManager/dnsmasq-shared.d is no longer here: the DHCP drop-in that
# needed it decided nothing and has been removed (K-15). Nothing this daemon does
# writes under /etc/NetworkManager any more — NetworkManager's own keyfiles are
# written by NetworkManager, on this daemon's behalf, over D-Bus.
ReadWritePaths=/etc/yonder /var/lib/yonder
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
