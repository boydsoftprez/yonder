# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=Yonder core configuration service
Documentation=https://github.com/boydsoftprez/yonder
After=local-fs.target NetworkManager.service systemd-modules-load.service sys-kernel-config.mount
Wants=NetworkManager.service sys-kernel-config.mount

[Service]
Type=simple
# /usr/local/bin/yonder-node, not /usr/bin/node: a unit's ExecStart is an
# absolute path that systemd resolves against nothing, and the offline install
# route puts its bundled runtime at /opt/yonder/node/bin/node and on PATH for
# the installer's own run only. Naming the distro path was therefore
# `Unable to locate executable '/usr/bin/node'`, status=203/EXEC, for ever
# under Restart=always. The installer's link_node points this fixed path at
# whichever node it resolved — bundled or packaged — so both routes look the
# same from here. See installer/lib/common.sh.
ExecStart=/usr/local/bin/yonder-node /opt/yonder/packages/yonder-core/dist/daemon/server.js
Restart=always
RestartSec=2
# No User=. This daemon drives NetworkManager and stays root.
#
# Group=, though, is what makes the socket reachable. systemd sets the
# process's primary group from this, so /run/yonder is created root:yonder
# 0750 and the socket the daemon binds inside it inherits that group; the
# chmod to 0660 in src/daemon/server.ts then makes it group-writable, and a
# console running as the unprivileged yonder user can open it. Nothing chowns
# from code: the unit is the one place this is expressed (K-01, R-SEC-04).
#
# The account must exist before this unit is started, or systemd fails it at
# step USER with status=217 on every start — which for this daemon is a board
# with no access point and no console. installer/roles/10-base.sh creates it
# and assert_unit_accounts checks it before anything is enabled.
Group=yonder
RuntimeDirectory=yonder
RuntimeDirectoryMode=0750
StateDirectory=yonder
StateDirectoryMode=0750
ProtectSystem=strict
# /etc/NetworkManager/dnsmasq-shared.d is no longer here: the DHCP drop-in that
# needed it decided nothing and has been removed (K-15). Nothing this daemon does
# writes under /etc/NetworkManager any more — NetworkManager's own keyfiles are
# written by NetworkManager, on this daemon's behalf, over D-Bus.
# /etc/mediamtx is the media server's generated configuration, and it is here
# for want of anywhere else this daemon may write that mediamtx may read. That
# file carries the RTSP credential, so it must not be world-readable; the
# media server runs as its own unprivileged account, so it cannot traverse
# /etc/yonder (0750 root:root, it holds secrets.yaml) and must not be put in
# group `yonder`, which owns the daemon's control socket. One narrow
# purpose-made directory is the smaller of the two widenings.
# assert_daemon_can_write in 50-mediamtx.sh checks this line against
# MEDIA_CONFIG_PATH, so the two cannot drift apart.
#
# /etc/mavlink-router is where MavlinkRenderer generates the router's own
# configuration (src/mav/renderer.ts, R-MAV-01). Without it the first real
# render fails EROFS with no other clue — the class of defect that only ever
# appears on a board.
#
# **The leading `-` is load-bearing.** systemd fails a unit outright when a
# path named here does not exist, and this directory is created by the role
# that installs mavlink-router — so on a board flashed before that role
# existed, an unprefixed entry would stop yonder-core starting at all: no
# console, no access point, no way in. A `-` makes a missing path ignored
# instead, which is the safe direction for a directory the daemon writes only
# when telemetry is installed at all.
# The installer loads libcomposite and mounts configfs before this namespace
# is constructed. Missing kernel support costs the camera, never core startup.
# FunctionFS mounts and flock files stay inside RuntimeDirectory=yonder.
ReadWritePaths=/etc/yonder /var/lib/yonder /etc/mediamtx -/etc/mavlink-router -/sys/kernel/config/usb_gadget
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
