  "fixed": [
    {
      "key": "nrdb-ui-text.nrdb-ui-widget.yonder-fixed.yonder-pending.yonder-qualifier#0",
      "text": "A change that moved the Wi-Fi radio is in force on this device, and the device is confirming it for itself."
    },
    {
      "key": "nrdb-ui-text.nrdb-ui-widget.yonder-fixed.yonder-pending.yonder-qualifier#1",
      "text": "There is nothing for you to confirm: the device keeps the change once it holds an address on the new network, and puts the previous configuration back by itself if it does not. Revert it now if you have decided against it."
    },
    {
      "key": "nrdb-ui-widget.nrdb-ui-yonder-databar.yonder-fixed",
      "text": "JOINyonderPASSPHRASEyonder1234AT192.168.77.1ORyonder.local"
    },
    {
      "key": "nrdb-ui-text.nrdb-ui-widget.yonder-fixed.yonder-qualifier",
      "text": "Join that network from a phone or a laptop and open this console at either address above, on the port you are using now. Worth photographing before you change anything: it is what gets you back in when this page stops answering."
    }
