{
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "network": {
      "type": "object",
      "properties": {
        "ap": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "ssid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "default": "yonder"
            },
            "psk": {
              "type": "object",
              "properties": {
                "secret": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "secret"
              ],
              "additionalProperties": false
            },
            "address": {
              "type": "string",
              "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}\\/(3[0-2]|[12]?\\d)$",
              "default": "192.168.77.1/24"
            },
            "fallback": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 30,
                  "maximum": 600,
                  "default": 90
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "required": [
            "psk"
          ],
          "additionalProperties": false
        },
        "client": {
          "type": "object",
          "properties": {
            "ssid": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "psk": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "secret": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "secret"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "default": {
            "ssid": null,
            "psk": null
          }
        },
        "ethernet": {
          "type": "object",
          "properties": {
            "dhcp": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "modem": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "appliance"
              ],
              "default": "auto"
            },
            "interface": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "apn": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "username": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "password": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "secret": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "secret"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "dial": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "priority": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ethernet",
              "modem",
              "wifi_client",
              "usb"
            ]
          },
          "minItems": 1,
          "default": [
            "ethernet",
            "modem",
            "wifi_client"
          ]
        }
      },
      "required": [
        "ap"
      ],
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 3000
        },
        "theme": {
          "type": "string",
          "enum": [
            "day",
            "night"
          ],
          "default": "day"
        },
        "editor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "password": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "secret": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "secret"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "interfaces": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ethernet",
                  "modem",
                  "wifi_client",
                  "usb"
                ]
              },
              "default": [
                "ethernet",
                "wifi_client"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "editor"
      ],
      "additionalProperties": false
    },
    "apply": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600,
          "default": 120
        },
        "radioTimeout": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600,
          "default": 300
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "system": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "default": "yonder"
        },
        "timezone": {
          "type": "string",
          "default": "UTC"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "remote": {
      "type": "object",
      "properties": {
        "zerotier": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "network_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          },
          "source": {
            "type": "string",
            "enum": [
              "usb"
            ]
          },
          "device": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "autostart": {
            "type": "boolean",
            "default": false
          },
          "width": {
            "type": "integer",
            "minimum": 160,
            "maximum": 3840,
            "default": 1280
          },
          "height": {
            "type": "integer",
            "minimum": 90,
            "maximum": 2160,
            "default": 720
          },
          "framerate": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "default": 30
          },
          "codec": {
            "type": "string",
            "enum": [
              "h264"
            ],
            "default": "h264"
          },
          "bitrate_kbps": {
            "type": "integer",
            "minimum": 100,
            "maximum": 20000,
            "default": 2000
          },
          "preview": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 160,
                "maximum": 1280,
                "default": 640
              },
              "height": {
                "type": "integer",
                "minimum": 90,
                "maximum": 720,
                "default": 360
              },
              "framerate": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30,
                "default": 15
              },
              "bitrate_kbps": {
                "type": "integer",
                "minimum": 100,
                "maximum": 2000,
                "default": 400
              }
            },
            "additionalProperties": false,
            "default": {}
          },
          "controls": {
            "type": "object",
            "properties": {
              "brightness": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "contrast": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "rotation": {
                "type": "number",
                "enum": [
                  0,
                  90,
                  180,
                  270
                ],
                "default": 0
              },
              "zoom": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "focus": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "exposureTime": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "whiteBalanceTemperature": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "gain": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "backlightCompensation": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "gamma": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "sharpness": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "saturation": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "hue": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -32768,
                    "maximum": 32767
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "powerLineFrequency": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "autoExposure": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "autoWhiteBalance": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null
              },
              "autoFocus": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null
              }
            },
            "additionalProperties": false,
            "default": {}
          },
          "outputs": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "rtp"
                    },
                    "enabled": {
                      "type": "boolean",
                      "default": true
                    },
                    "host": {
                      "type": "string",
                      "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}$"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  },
                  "required": [
                    "kind",
                    "host",
                    "port"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "rtsp"
                    },
                    "enabled": {
                      "type": "boolean",
                      "default": true
                    },
                    "password": {
                      "type": "object",
                      "properties": {
                        "secret": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "secret"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "password"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "srt"
                    },
                    "enabled": {
                      "type": "boolean",
                      "default": true
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  },
                  "required": [
                    "kind",
                    "port"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "maxItems": 8,
            "default": []
          }
        },
        "required": [
          "id",
          "name",
          "source",
          "device"
        ],
        "additionalProperties": false
      },
      "maxItems": 8,
      "default": []
    }
  },
  "required": [
    "version",
    "network",
    "ui"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yonder configuration"
}
