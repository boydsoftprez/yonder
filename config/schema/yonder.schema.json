{
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "network": {
      "type": "object",
      "properties": {
        "ap": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "ssid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "default": "yonder"
            },
            "psk": {
              "type": "object",
              "properties": {
                "secret": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "secret"
              ],
              "additionalProperties": false
            },
            "address": {
              "type": "string",
              "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}\\/(3[0-2]|[12]?\\d)$",
              "default": "192.168.77.1/24"
            },
            "fallback": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 30,
                  "maximum": 600,
                  "default": 90
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "required": [
            "psk"
          ],
          "additionalProperties": false
        },
        "client": {
          "type": "object",
          "properties": {
            "ssid": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "psk": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "secret": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "secret"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "default": {
            "ssid": null,
            "psk": null
          }
        },
        "ethernet": {
          "type": "object",
          "properties": {
            "dhcp": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "priority": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ethernet",
              "modem",
              "wifi_client",
              "usb"
            ]
          },
          "minItems": 1,
          "default": [
            "ethernet",
            "modem",
            "wifi_client"
          ]
        }
      },
      "required": [
        "ap"
      ],
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 3000
        },
        "theme": {
          "type": "string",
          "enum": [
            "day",
            "night",
            "sunlight"
          ],
          "default": "day"
        },
        "editor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "password": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "secret": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "secret"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "interfaces": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ethernet",
                  "modem",
                  "wifi_client",
                  "usb"
                ]
              },
              "default": [
                "ethernet",
                "wifi_client"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "editor"
      ],
      "additionalProperties": false
    },
    "apply": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600,
          "default": 120
        },
        "radioTimeout": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600,
          "default": 300
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "system": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "default": "yonder"
        },
        "timezone": {
          "type": "string",
          "default": "UTC"
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "required": [
    "version",
    "network",
    "ui"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yonder configuration"
}
