{
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "network": {
      "type": "object",
      "properties": {
        "ap": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "ssid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "default": "yonder"
            },
            "psk": {
              "type": "object",
              "properties": {
                "secret": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "secret"
              ],
              "additionalProperties": false
            },
            "address": {
              "type": "string",
              "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}\\/\\d{1,2}$",
              "default": "192.168.77.1/24"
            },
            "dhcp": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$",
                  "default": "192.168.77.2"
                },
                "end": {
                  "type": "string",
                  "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$",
                  "default": "192.168.77.50"
                },
                "lease": {
                  "type": "string",
                  "pattern": "^\\d+[mhd]$",
                  "default": "12h"
                }
              },
              "additionalProperties": false,
              "default": {}
            },
            "fallback": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 30,
                  "maximum": 600,
                  "default": 90
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "required": [
            "psk"
          ],
          "additionalProperties": false
        },
        "client": {
          "type": "object",
          "properties": {
            "ssid": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "psk": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "secret": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "secret"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "default": {
            "ssid": null,
            "psk": null
          }
        },
        "ethernet": {
          "type": "object",
          "properties": {
            "dhcp": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "priority": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ethernet",
              "modem",
              "wifi_client",
              "usb"
            ]
          },
          "minItems": 1,
          "default": [
            "ethernet",
            "modem",
            "wifi_client"
          ]
        }
      },
      "required": [
        "ap"
      ],
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 3000
        },
        "theme": {
          "type": "string",
          "enum": [
            "day",
            "night"
          ],
          "default": "day"
        },
        "editor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "password": {
              "type": "object",
              "properties": {
                "secret": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "secret"
              ],
              "additionalProperties": false
            },
            "interfaces": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ethernet",
                  "modem",
                  "wifi_client",
                  "usb"
                ]
              },
              "default": [
                "ethernet",
                "wifi_client"
              ]
            }
          },
          "required": [
            "password"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "editor"
      ],
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "default": "yonder"
        },
        "timezone": {
          "type": "string",
          "default": "UTC"
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "required": [
    "version",
    "network",
    "ui"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yonder configuration"
}
