{
  "name": "node-red-contrib-yonder-system",
  "version": "2026.9.0",
  "license": "GPL-3.0-or-later",
  "description": "Yonder console nodes for board facts, the activity log and reachability probes. Thin adapters over the yonder-core daemon socket; every decision lives in yonder-core.",
  "keywords": [
    "node-red",
    "yonder"
  ],
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "yonder-status": "dist/status.js",
      "yonder-activity": "dist/activity.js",
      "yonder-diag": "dist/diag.js",
      "yonder-theme": "dist/theme.js",
      "yonder-netstate": "dist/netstate.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-node-html.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "yonder-core": "2026.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
