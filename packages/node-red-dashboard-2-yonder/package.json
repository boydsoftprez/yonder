{
  "name": "node-red-dashboard-2-yonder",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "description": "Yonder's instrument objects for Dashboard 2.x \u2014 engine bars, tapes, annunciators, data bars, identities, soft keys, hold keys and sparklines. The console's visual language, built once (ADR-0009).",
  "keywords": [
    "node-red",
    "node-red-dashboard-2",
    "yonder"
  ],
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "ui-yonder-gauge": "dist/gauge.js",
      "ui-yonder-tape": "dist/tape.js",
      "ui-yonder-annunciator": "dist/annunciator.js",
      "ui-yonder-databar": "dist/databar.js",
      "ui-yonder-softkeys": "dist/softkeys.js",
      "ui-yonder-identity": "dist/identity.js",
      "ui-yonder-sparkline": "dist/sparkline.js",
      "ui-yonder-holdkey": "dist/holdkey.js",
      "ui-yonder-picture": "dist/picture.js",
      "ui-yonder-facts": "dist/facts.js",
      "ui-yonder-budget": "dist/budget.js",
      "ui-yonder-deck": "dist/deck.js",
      "ui-yonder-aim": "dist/aim.js",
      "ui-yonder-index": "dist/index-widget.js",
      "ui-yonder-flow": "dist/flow.js",
      "ui-yonder-captures": "dist/captures.js",
      "ui-yonder-cockpit": "dist/cockpit.js",
      "ui-yonder-interfaces": "dist/interfaces.js",
      "ui-yonder-diagnostics": "dist/diagnostics.js",
      "ui-yonder-settings": "dist/settings.js"
    }
  },
  "node-red-dashboard-2": {
    "version": "1.0.0",
    "widgets": {
      "ui-yonder-gauge": {
        "output": "ui-yonder-gauge.umd.js",
        "component": "YonderGauge"
      },
      "ui-yonder-tape": {
        "output": "ui-yonder-tape.umd.js",
        "component": "YonderTape"
      },
      "ui-yonder-annunciator": {
        "output": "ui-yonder-annunciator.umd.js",
        "component": "YonderAnnunciator"
      },
      "ui-yonder-databar": {
        "output": "ui-yonder-databar.umd.js",
        "component": "YonderDataBar"
      },
      "ui-yonder-softkeys": {
        "output": "ui-yonder-softkeys.umd.js",
        "component": "YonderSoftKeys"
      },
      "ui-yonder-identity": {
        "output": "ui-yonder-identity.umd.js",
        "component": "YonderIdentity"
      },
      "ui-yonder-sparkline": {
        "output": "ui-yonder-sparkline.umd.js",
        "component": "YonderSparkline"
      },
      "ui-yonder-holdkey": {
        "output": "ui-yonder-holdkey.umd.js",
        "component": "YonderHoldKey"
      },
      "ui-yonder-picture": {
        "output": "ui-yonder-picture.umd.js",
        "component": "YonderPicture"
      },
      "ui-yonder-facts": {
        "output": "ui-yonder-facts.umd.js",
        "component": "YonderFacts"
      },
      "ui-yonder-budget": {
        "output": "ui-yonder-budget.umd.js",
        "component": "YonderBudget"
      },
      "ui-yonder-deck": {
        "output": "ui-yonder-deck.umd.js",
        "component": "YonderDeck"
      },
      "ui-yonder-aim": {
        "output": "ui-yonder-aim.umd.js",
        "component": "YonderAim"
      },
      "ui-yonder-index": {
        "output": "ui-yonder-index.umd.js",
        "component": "YonderIndex"
      },
      "ui-yonder-flow": {
        "output": "ui-yonder-flow.umd.js",
        "component": "YonderFlow"
      },
      "ui-yonder-captures": {
        "output": "ui-yonder-captures.umd.js",
        "component": "YonderCaptures"
      },
      "ui-yonder-cockpit": {
        "output": "ui-yonder-cockpit.umd.js",
        "component": "YonderCockpit"
      },
      "ui-yonder-interfaces": {
        "output": "ui-yonder-interfaces.umd.js",
        "component": "YonderInterfaces"
      },
      "ui-yonder-diagnostics": {
        "output": "ui-yonder-diagnostics.umd.js",
        "component": "YonderDiagnostics"
      },
      "ui-yonder-settings": {
        "output": "ui-yonder-settings.umd.js",
        "component": "YonderSettings"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-node-html.mjs && node scripts/build-widgets.mjs",
    "build:nodes": "tsc -p tsconfig.json && node ../../scripts/copy-node-html.mjs",
    "test": "vitest run",
    "gallery": "npm run build -w yonder-core && node gallery/build-themes.mjs && vite build --config gallery/vite.config.mjs",
    "cockpit:dev": "vite --config cockpit/vite.config.mjs",
    "cockpit:verify": "node cockpit/verify.mjs",
    "cockpit:guide": "node cockpit/guide.mjs && node cockpit/guide-terrain.mjs",
    "cockpit:guide:sitl": "node cockpit/guide-sitl.mjs",
    "cockpit:guide:layouts": "node cockpit/layout-guide.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "yonder-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
