{
  "name": "node-red-contrib-yonder-network",
  "version": "2026.9.0",
  "license": "GPL-3.0-or-later",
  "description": "Yonder console nodes for reading the configuration, scanning for Wi-Fi networks, and the apply/confirm cycle. Thin adapters over the yonder-core daemon socket; every decision lives in yonder-core.",
  "keywords": [
    "node-red",
    "yonder"
  ],
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "yonder-config": "dist/config.js",
      "yonder-config-watch": "dist/watch.js",
      "yonder-scan": "dist/scan.js",
      "yonder-apply": "dist/apply.js",
      "yonder-confirm": "dist/confirm.js",
      "yonder-revert": "dist/revert.js",
      "yonder-pending": "dist/pending.js",
      "yonder-wayback": "dist/wayback.js",
      "yonder-join": "dist/join.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-node-html.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "yonder-core": "2026.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
