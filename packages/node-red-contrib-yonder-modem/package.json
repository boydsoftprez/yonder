{
  "name": "node-red-contrib-yonder-modem",
  "version": "2026.9.0",
  "license": "GPL-3.0-or-later",
  "description": "Yonder console nodes for the cellular link: modem and reach state, seed the connection form, configure, test. Thin adapters over the yonder-core daemon socket; every decision lives in yonder-core.",
  "keywords": [
    "node-red",
    "yonder"
  ],
  "node-red": {
    "version": ">=5.0.0",
    "nodes": {
      "yonder-modem-state": "dist/state.js",
      "yonder-modem-configure": "dist/configure.js",
      "yonder-modem-form": "dist/form.js",
      "yonder-reach-test": "dist/test.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-node-html.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "yonder-core": "2026.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
