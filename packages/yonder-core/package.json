{
  "name": "yonder-core",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "yonder-core": "./dist/daemon/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "schema": "tsc -p tsconfig.json && node dist/schema/generate.js ../../config/schema/yonder.schema.json",
    "defaults": "tsc -p tsconfig.json && node dist/config/defaults.js ../../config/defaults/config.yaml"
  },
  "dependencies": {
    "node-mavlink": "2.3.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presentation": {
      "types": "./dist/console/presentation.d.ts",
      "default": "./dist/console/presentation.js"
    },
    "./package.json": "./package.json",
    "./cockpit-wire": {
      "types": "./dist/cockpit/flight-wire.d.ts",
      "default": "./dist/cockpit/flight-wire.js"
    },
    "./terrain": {
      "types": "./dist/terrain/index.d.ts",
      "default": "./dist/terrain/index.js"
    },
    "./terrain/service": {
      "types": "./dist/terrain/service.d.ts",
      "default": "./dist/terrain/service.js"
    }
  }
}
