[Unit]
Description=Prepare the SeekerHD CSI camera on Radxa Zero 3
After=systemd-modules-load.service systemd-udev-trigger.service
Before=yonder-core.service
ConditionPathExists=/boot/overlay-user/seekerhd-imx462.dtbo
ConditionPathExistsGlob=/sys/bus/i2c/drivers/imx462/*-001a

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/yonder-seekerhd/prepare.py
RemainAfterExit=yes
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
