+#define SEEKERHD_ISP_SOCKET "/run/yonder-seekerhd/isp.sock"
+#define SEEKERHD_ACTIVE_IQ \
+    "/usr/local/share/yonder-seekerhd/iqfiles/imx462_IMX462_default.json"
+#define SEEKERHD_PROFILE_DIR "/usr/local/share/yonder-seekerhd/profiles/"
+#define SEEKERHD_MAX_IQ_SIZE (16U * 1024U * 1024U)
+
+struct seekerhd_values {
+    unsigned int brightness;
