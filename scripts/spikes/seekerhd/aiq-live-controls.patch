+
+static bool seekerhd_values_equal(const struct seekerhd_values& a,
+                                  const struct seekerhd_values& b)
+{
+    return a.brightness == b.brightness && a.contrast == b.contrast &&
+           a.saturation == b.saturation && a.hue == b.hue;
+}
+
+struct seekerhd_live_controls {
+    pthread_mutex_t lock;
+    rk_aiq_sys_ctx_t *ctx;
+    const char *device;
+    const char *sensor;
+    const struct seekerhd_profile *active_profile;
+    bool running;
+    int listen_fd;
