+    __u32 index;
+    __u32 pad;
+    __u32 code;
+    __u32 width;
+    __u32 height;
+    struct v4l2_fract interval;
+    __u32 which;
+    __u32 reserved[8];
+};
+static_assert(sizeof(rkisp_v4l2_subdev_frame_interval_enum) == 64,
+              "Rockchip frame interval ABI size changed");
+static_assert(offsetof(rkisp_v4l2_subdev_frame_interval_enum, reserved) == 32,
+              "Rockchip HDR mode ABI offset changed");
