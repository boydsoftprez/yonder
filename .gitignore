node_modules/
dist/
*.log
.DS_Store

# Bundled Node runtime for offline installs. installer/lib/common.sh's
# install_bundled_node copies vendor/node into images when present; it is a
# downloaded binary, not source, so it is never committed.
vendor/

# Device state. secrets.yaml holds per-device credentials and config.yaml is
# whatever one board happens to be set to; neither belongs in the repository.
# Shipped defaults live in config/defaults/ and are exempt.
secrets.yaml
config.yaml
!config/defaults/*.yaml
# ...but never a file named secrets.yaml, even a shipped default: re-exclude
# it specifically so the negation above can never un-ignore one.
config/defaults/secrets.yaml

# Local R&D scratch. Never committed.
research/
notes/
*.img
*.img.xz

# Built widget bundles. Generated by `npm run build -w node-red-dashboard-2-yonder`
# from the Vue sources; the installer builds them on the device.
packages/node-red-dashboard-2-yonder/dist/
packages/node-red-dashboard-2-yonder/resources/
packages/node-red-dashboard-2-yonder/.build/

# The gallery's two palettes. Generated by `npm run gallery`'s own
# build-themes.mjs, from yonder-core's `themeCss()` — regenerated on every
# build, so a committed copy could only ever go stale next to the generator.
packages/node-red-dashboard-2-yonder/gallery/public/

# Brainstorming companion scratch (mockups, not shipped)
.superpowers/
